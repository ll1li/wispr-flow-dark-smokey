#!/usr/bin/env bash
set -euo pipefail

VERSION="1.5.0"

# launchd starts agents with a bare PATH; make sure node/npx from the usual
# installers (Homebrew, nodejs.org, nvm, fnm, volta) are reachable.
PATH="$PATH:/usr/local/bin:/opt/homebrew/bin:$HOME/.local/bin:$HOME/.volta/bin:$HOME/.fnm/aliases/default/bin"
for d in "$HOME"/.nvm/versions/node/*/bin; do [[ -d "$d" ]] && PATH="$PATH:$d"; done
export PATH

ASAR="${WISPR_PATH:-/Applications/Wispr Flow.app}/Contents/Resources/app.asar"
UNPACKED="${ASAR}.unpacked"
BACKUP="${ASAR}.bak"
BACKUP_UNPACKED="${BACKUP}.unpacked"
ASAR_WRITTEN=0
TMPFILE=""
MARKER="data-wispr-dark-smokey"

# Auto re-apply: a per-user LaunchAgent that runs `--ensure` at login, every
# hour, and whenever app.asar changes (i.e. right after a Wispr Flow update).
AGENT_LABEL="wispr-flow-dark-smokey"
AGENT_PLIST="$HOME/Library/LaunchAgents/${AGENT_LABEL}.plist"
AGENT_LOG="${TMPDIR:-/tmp}/${AGENT_LABEL}.log"
STAMP_DIR="$HOME/.cache/${AGENT_LABEL}"
STAMP="$STAMP_DIR/ensure-failed"   # asar identity of the last failed --ensure; stops retry loops
ENSURE=0

# Pinned version for predictable behaviour
ASAR_CMD="@electron/asar@4.2.0"

# Track whether the app was running before we kill it
APP_WAS_RUNNING=0
pgrep -x 'Wispr Flow' >/dev/null && APP_WAS_RUNNING=1 || true

usage() {
  cat <<EOF
wispr-flow-dark-smokey $VERSION — dark theme for Wispr Flow

Usage: wispr-flow-dark-smokey [option]

  (no args)       Apply the dark theme (restarts Wispr Flow)
  --restore       Restore original Wispr Flow
  --check         Check if the theme is applied (exit 0 = applied, 1 = not)
  --ensure        Apply only if not applied; quiet, never restarts a themed app
  --enable-auto   Keep the theme across Wispr Flow updates (LaunchAgent)
  --disable-auto  Remove the LaunchAgent
  --uninstall     Restore the app, remove the LaunchAgent and this command
  --version       Print version
  --help          Show this help

Set WISPR_PATH to override the default install location.
EOF
  exit 0
}

# Argument parsing
ACTION="apply"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --help)         usage ;;
    --version)      echo "wispr-flow-dark-smokey $VERSION"; exit 0 ;;
    --restore)      ACTION="restore"; shift ;;
    --check)        ACTION="check"; shift ;;
    --ensure)       ACTION="apply"; ENSURE=1; shift ;;
    --enable-auto)  ACTION="enable-auto"; shift ;;
    --disable-auto) ACTION="disable-auto"; shift ;;
    --uninstall)    ACTION="uninstall"; shift ;;
    *) echo "Error: unknown argument '$1'"; echo; usage ;;
  esac
done

self_path() {
  local p="$0"
  [[ "$p" == */* ]] || p="$(command -v "$p" || echo "$p")"
  cd "$(dirname "$p")" && printf '%s/%s\n' "$(pwd -P)" "$(basename "$p")"
}

launchctl_unload() {
  launchctl bootout "gui/$(id -u)/$AGENT_LABEL" 2>/dev/null \
    || launchctl unload "$AGENT_PLIST" 2>/dev/null || true
}

# --enable-auto / --disable-auto: no Wispr Flow or node needed for these.
if [[ "$ACTION" == "enable-auto" ]]; then
  SELF="$(self_path)"
  mkdir -p "$(dirname "$AGENT_PLIST")"
  cat > "$AGENT_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${AGENT_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${SELF}</string>
    <string>--ensure</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>WatchPaths</key>
  <array><string>${ASAR}</string></array>
  <key>StandardOutPath</key><string>${AGENT_LOG}</string>
  <key>StandardErrorPath</key><string>${AGENT_LOG}</string>
</dict>
</plist>
EOF
  launchctl_unload
  launchctl bootstrap "gui/$(id -u)" "$AGENT_PLIST" 2>/dev/null \
    || launchctl load -w "$AGENT_PLIST"
  echo "Auto re-apply enabled: $AGENT_PLIST"
  echo "Runs '$SELF --ensure' at login, hourly, and when Wispr Flow updates."
  exit 0
fi

if [[ "$ACTION" == "disable-auto" ]]; then
  if [[ -f "$AGENT_PLIST" ]]; then
    launchctl_unload
    rm -f "$AGENT_PLIST"
    echo "Auto re-apply disabled."
  else
    echo "Auto re-apply was not enabled."
  fi
  exit 0
fi

if [[ "$ACTION" == "uninstall" ]]; then
  SELF="$(self_path)"
  if [[ -f "$BACKUP" ]]; then
    "$SELF" --restore
  else
    echo "No backup found — Wispr Flow left as is."
  fi
  "$SELF" --disable-auto
  rm -rf "$STAMP_DIR"
  if [[ -w "$(dirname "$SELF")" ]]; then rm -f "$SELF"; else sudo rm -f "$SELF"; fi
  echo "Removed $SELF. Wispr Flow Dark-Smokey is uninstalled."
  exit 0
fi

if [[ ! -f "$ASAR" ]]; then
  [[ "$ENSURE" == "1" ]] && exit 0     # nothing to keep dark; stay quiet for launchd
  echo "Error: Wispr Flow not found at $ASAR"; exit 1
fi

# The asar format stores HTML uncompressed, so the marker is searchable as a
# literal string in the binary — no extract needed.
is_applied() { LC_ALL=C grep -qa "$MARKER" "$ASAR" 2>/dev/null; }
asar_id()    { stat -f '%m:%z' "$ASAR" 2>/dev/null || stat -c '%Y:%s' "$ASAR"; }

if [[ "$ACTION" == "check" ]]; then
  if is_applied; then echo "Dark Smokey is applied."; exit 0
  else echo "Dark Smokey is not applied."; exit 1; fi
fi

# Already dark: --ensure is done before it needs node at all.
[[ "$ENSURE" == "1" ]] && is_applied && exit 0

if ! command -v npx &>/dev/null; then
  [[ "$ENSURE" == "1" ]] && { echo "npx not found; cannot re-apply"; exit 0; }
  echo "Error: Node.js required (npx not found). Install: https://nodejs.org"; exit 1
fi

# --ensure: only act when the theme is missing, and do not retry an asar that
# already failed once (a restructured Wispr Flow would otherwise get its app
# killed and restarted on every trigger).
if [[ "$ENSURE" == "1" ]]; then
  if [[ -f "$STAMP" && "$(cat "$STAMP")" == "$(asar_id)" ]]; then
    echo "skipping: last attempt on this Wispr Flow build failed"; exit 0
  fi
  echo "$(date '+%Y-%m-%d %H:%M:%S') theme missing — re-applying"
fi

WORKDIR=$(mktemp -d)
cleanup() {
  local rc=$?
  rm -rf "$WORKDIR"
  [[ -n "$TMPFILE" && -f "$TMPFILE" ]] && rm -f "$TMPFILE"
  if [[ "$ENSURE" == "1" && "$ACTION" == "apply" ]]; then
    if [[ "$rc" -ne 0 ]]; then mkdir -p "$STAMP_DIR"; asar_id > "$STAMP"
    else rm -f "$STAMP"; fi
  fi
  if [[ "$ASAR_WRITTEN" == "1" ]]; then
    killall 'Wispr Flow' 2>/dev/null || true
    for _ in 1 2 3 4 5; do pgrep -f 'Wispr Flow' >/dev/null || break; sleep 1; done
    open -a 'Wispr Flow' 2>/dev/null || true
  elif [[ "$APP_WAS_RUNNING" == "1" ]]; then
    # Script failed after killing the app — restart so user isn't left with nothing
    open -a 'Wispr Flow' 2>/dev/null || true
  fi
}
trap cleanup EXIT

# Kill Wispr BEFORE touching anything
if [[ "$APP_WAS_RUNNING" == "1" ]]; then
  killall 'Wispr Flow' 2>/dev/null || true
  for _ in 1 2 3 4 5; do pgrep -f 'Wispr Flow' >/dev/null || break; sleep 1; done
fi

# --restore
if [[ "$ACTION" == "restore" ]]; then
  [[ -f "$BACKUP" ]] || { echo "No backup found."; exit 1; }
  mv "$BACKUP" "$ASAR"
  if [[ -d "$BACKUP_UNPACKED" ]]; then
    UNPACKED_TMP="${UNPACKED}.restoring.$$"
    mv "$UNPACKED" "$UNPACKED_TMP" 2>/dev/null || true
    if mv "$BACKUP_UNPACKED" "$UNPACKED"; then
      rm -rf "$UNPACKED_TMP"
    else
      mv "$UNPACKED_TMP" "$UNPACKED" 2>/dev/null || true
      echo "Error: failed to restore $UNPACKED — original left intact."
      exit 1
    fi
  fi
  ASAR_WRITTEN=1
  echo "Restored. Wispr Flow will restart."
  exit 0
fi

# Backup (first run only) — must include .unpacked dir for native binaries
if [[ ! -f "$BACKUP" ]]; then
  cp "$ASAR" "$BACKUP"
  if [[ -d "$UNPACKED" ]]; then
    cp -R "$UNPACKED" "$BACKUP_UNPACKED"
  fi
fi

# Always extract from clean backup
echo "==> Extracting..."
npx --yes "$ASAR_CMD" extract "$BACKUP" "$WORKDIR/wispr"

# Theme CSS — injected before </head>, preserving all original content
#
# Strategy: filter:invert on <html> flips the entire rendered UI to dark.
# Everything below compensates for side-effects of that inversion:
#
#   1. invert(0.91)          — high invert for deep dark, avoids pure-black
#   2. hue-rotate(180deg)    — restores hue relationships after inversion
#   3. brightness(0.93)      — minimal pullback to stay dark (no sepia — neutral tone)
#   4. #15131a bg            — neutral dark with faint cool tint, prevents white flash
#   5. --sand-* / --vast-*   — graduated near-white values so inversion
#                              produces natural depth variation
#   6. img/video/canvas      — counter-invert to restore natural media colours
DARK_CSS='<style data-wispr-dark-smokey>html{background:#15131a!important;filter:invert(.91) hue-rotate(180deg) brightness(.93)!important;-webkit-font-smoothing:antialiased!important}body{background:#15131a!important}img,video,canvas,svg image,picture>img{filter:invert(1) hue-rotate(180deg)!important}:root{--sand-50:#fff!important;--sand-100:#fefefe!important;--sand-200:#fdfdfc!important;--sand-300:#fcfcfb!important;--sand-400:#fbfbfa!important;--sand-500:#fafaf9!important;--vast-50:#fefefe!important;--vast-100:#fdfdfc!important;--neutral-10:#fff!important}*:focus-visible{outline:2px solid rgba(100,149,237,.6)!important;outline-offset:2px!important}::-webkit-scrollbar{width:5px;height:5px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:rgba(128,128,128,.22);border-radius:3px}::-webkit-scrollbar-thumb:hover{background:rgba(128,128,128,.5)}::-webkit-scrollbar-thumb:active{background:rgba(128,128,128,.7)}::selection{background:rgba(120,130,170,.35)!important;color:inherit!important}</style>'

STATUS_CSS='<style data-wispr-dark-smokey>html,body{background:transparent!important}*{border-color:transparent!important;box-shadow:none!important}</style>'

# Inject into existing HTML — preserves all original script tags and content.
# Strip pattern matches both legacy bare markers and any attribute-bearing
# markers from intermediate v1.4.x installs, so upgrades are clean.
for renderer in hub scratchpad contextMenu; do
  target="$WORKDIR/wispr/.webpack/renderer/$renderer/index.html"
  [[ -f "$target" ]] || { echo "Error: $renderer not found — Wispr Flow may have updated its structure."; exit 1; }

  if grep -q "$MARKER" "$target"; then
    echo "==> Stripping old patch from $renderer..."
    sed -i '' "s|<style ${MARKER}[^>]*>.*</style>||g" "$target"
  fi

  echo "==> Patching $renderer..."
  sed -i '' "s|</head>|${DARK_CSS}</head>|" "$target"
  grep -q "$MARKER" "$target" || {
    echo "Error: failed to inject CSS into $renderer — </head> not found in $target"
    exit 1
  }
done

# Status bar: no invert — already dark/transparent natively
target="$WORKDIR/wispr/.webpack/renderer/status/index.html"
if [[ -f "$target" ]]; then
  if grep -q "$MARKER" "$target"; then
    sed -i '' "s|<style ${MARKER}[^>]*>.*</style>||g" "$target"
  fi
  echo "==> Patching status..."
  sed -i '' "s|</head>|${STATUS_CSS}</head>|" "$target"
  grep -q "$MARKER" "$target" || {
    echo "Error: failed to inject CSS into status — </head> not found in $target"
    exit 1
  }
fi

# Pack to temp on same filesystem, then atomic rename. Verify the temp file
# matches the packed source before swapping — catches truncated copies on
# disk-pressure conditions.
echo "==> Repacking..."
npx --yes "$ASAR_CMD" pack "$WORKDIR/wispr" "$WORKDIR/patched.asar"
PACKED_SIZE=$(wc -c < "$WORKDIR/patched.asar" | tr -d ' ')
[[ "$PACKED_SIZE" -gt 0 ]] || { echo "Error: asar pack produced empty file"; exit 1; }

TMPFILE=$(mktemp "$(dirname "$ASAR")/.app.asar.tmp.XXXXXXXXXX")
cp "$WORKDIR/patched.asar" "$TMPFILE"
TMP_SIZE=$(wc -c < "$TMPFILE" | tr -d ' ')
[[ "$TMP_SIZE" -eq "$PACKED_SIZE" ]] || { echo "Error: temp file copy truncated ($TMP_SIZE / $PACKED_SIZE bytes)"; exit 1; }

mv "$TMPFILE" "$ASAR"
TMPFILE=""  # mv consumed it; prevent cleanup from attempting rm
ASAR_WRITTEN=1

echo "Done. Wispr Flow Dark-Smokey applied."
